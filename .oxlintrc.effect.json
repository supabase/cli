    "!apps/cli/tests/helpers/secrets-live.ts",
    "!apps/cli/tests/helpers/storage-live.ts",
    "!apps/cli/src/command-internal/agent-mode.*",
    "!apps/cli/src/command-internal/api-*",
    "!apps/cli/src/command-internal/bitbucket-pipeline.ts",
    "!apps/cli/src/command-internal/branch-ref.*",
    "!apps/cli/src/command-internal/branch-target.*",
    "!apps/cli/src/command-internal/bundled-postgres-client.*",
