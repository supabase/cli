{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supabase.com/docs/cli/supabase-lock/v1.schema.json",
  "title": "supabase.lock",
  "description": "The service versions that supabase start pins in supabase/supabase.lock.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "enum": [
        "https://supabase.com/docs/cli/supabase-lock/v1.schema.json"
      ]
    },
    "lockfileVersion": {
      "type": "number",
      "enum": [
        1
      ]
    },
    "linked": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "branch": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "isDefault": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "ref",
            "isDefault"
          ],
          "additionalProperties": true
        },
        "observedAt": {
          "type": "string"
        }
      },
      "required": [
        "project",
        "branch",
        "observedAt"
      ],
      "additionalProperties": true
    },
    "services": {
      "type": "object",
      "properties": {
        "database": {
          "$ref": "#/$defs/DatabaseLock"
        },
        "rest": {
          "$ref": "#/$defs/ServiceLock"
        },
        "auth": {
          "$ref": "#/$defs/ServiceLock"
        },
        "realtime": {
          "$ref": "#/$defs/ServiceLock"
        },
        "storage": {
          "$ref": "#/$defs/ServiceLock"
        },
        "imgproxy": {
          "$ref": "#/$defs/ServiceLock"
        },
        "functions": {
          "$ref": "#/$defs/ServiceLock"
        },
        "studio": {
          "$ref": "#/$defs/ServiceLock"
        },
        "pgmeta": {
          "$ref": "#/$defs/ServiceLock"
        },
        "mail": {
          "$ref": "#/$defs/ServiceLock"
        },
        "analytics": {
          "$ref": "#/$defs/ServiceLock"
        },
        "pooler": {
          "$ref": "#/$defs/ServiceLock"
        }
      },
      "required": [
        "database",
        "rest",
        "auth",
        "realtime",
        "storage",
        "imgproxy",
        "functions",
        "studio",
        "pgmeta",
        "mail",
        "analytics",
        "pooler"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "$schema",
    "lockfileVersion",
    "services"
  ],
  "additionalProperties": true,
  "$defs": {
    "LinkedVersion": {
      "type": "object",
      "properties": {
        "raw": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "raw",
        "version"
      ],
      "additionalProperties": true
    },
    "NativePin": {
      "type": "object",
      "properties": {
        "archive": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "archive",
        "manifest"
      ],
      "additionalProperties": true
    },
    "ArtifactPin": {
      "type": "object",
      "properties": {
        "upstreamVersion": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "image": {
          "type": "string"
        },
        "upstreamImage": {
          "type": "string"
        },
        "natives": {
          "type": "object",
          "properties": {
            "darwin-arm64": {
              "$ref": "#/$defs/NativePin"
            },
            "linux-amd64": {
              "$ref": "#/$defs/NativePin"
            },
            "linux-arm64": {
              "$ref": "#/$defs/NativePin"
            }
          },
          "required": [
            "darwin-arm64",
            "linux-amd64",
            "linux-arm64"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "upstreamVersion",
        "revision",
        "image",
        "upstreamImage",
        "natives"
      ],
      "additionalProperties": true
    },
    "DatabaseLock": {
      "type": "object",
      "properties": {
        "specifier": {
          "type": "string"
        },
        "linked": {
          "$ref": "#/$defs/LinkedVersion"
        },
        "resolution": {
          "type": "string",
          "enum": [
            "resolved",
            "unlinked",
            "unobserved",
            "unpublished"
          ]
        },
        "resolved": {
          "$ref": "#/$defs/ArtifactPin"
        },
        "majorVersion": {
          "type": "integer"
        },
        "line": {
          "type": "string",
          "enum": [
            "stock",
            "orioledb"
          ]
        }
      },
      "required": [
        "specifier",
        "resolution",
        "resolved",
        "majorVersion",
        "line"
      ],
      "additionalProperties": true
    },
    "ServiceLock": {
      "type": "object",
      "properties": {
        "specifier": {
          "type": "string"
        },
        "linked": {
          "$ref": "#/$defs/LinkedVersion"
        },
        "resolution": {
          "type": "string",
          "enum": [
            "resolved",
            "unlinked",
            "unobserved",
            "unpublished"
          ]
        },
        "resolved": {
          "$ref": "#/$defs/ArtifactPin"
        }
      },
      "required": [
        "specifier",
        "resolution",
        "resolved"
      ],
      "additionalProperties": true
    }
  }
}
