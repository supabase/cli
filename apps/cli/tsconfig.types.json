{
  // Type-check-only overlay, kept for the `@supabase/pg-topo` pin inherited from `tsconfig.json`
  // (see the note there). `@supabase/postgrest-typegen` used to be pinned here too, until it
  // compiled under this workspace's options (SDK-1963); it is now reached only through
  // `@supabase/typegen` and type-checked from source like every other `bun`-condition package.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `paths` replaces the base map wholesale, so the inherited pin is repeated here.
    "paths": {
      "@supabase/pg-topo": ["./node_modules/@supabase/pg-topo/dist/index.d.ts"]
    }
  }
}
