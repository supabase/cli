{
  "name": "supabase",
  "version": "0.0.0-automated",
  "private": false,
  "description": "Supabase CLI",
  "homepage": "https://github.com/supabase/cli#readme",
  "bugs": {
    "url": "https://github.com/supabase/cli/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/supabase/cli.git",
    "directory": "apps/cli"
  },
  "bin": {
    "supabase": "dist/supabase.js"
  },
  "files": [
    "dist/supabase.js"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:go-sidecar && pnpm build:legacy && pnpm build:shim",
    "build:go-sidecar": "mkdir -p dist && cp ../cli-go/supabase-go dist/supabase-go",
    "build:legacy": "bun scripts/build-binary.ts",
    "build:shim": "bun build src/shared/cli/bin.ts --outfile dist/supabase.js --target node",
    "docs:spec": "bun scripts/generate-docs-spec.ts",
    "dev:legacy": "pnpm exec bun src/legacy/main.ts",
    "types:check": "tsc --noEmit",
    "test": "bun --bun vitest run --project unit --project integration",
    "test:unit": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration",
    "test:e2e": "pnpm exec turbo run supabase#build && bun --bun vitest run --project e2e --project e2e-stack",
    "test:live": "bun --bun vitest run --project live",
    "test:smoke": "bun run tests/smoke-test.ts"
  },
  "dependencies": {
    "eciesjs": "^0.5.0",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.246",
    "@anthropic-ai/sdk": "^0.120.0",
    "@clack/prompts": "^1.7.0",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/vitest": "catalog:",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^1.3.0",
    "@supabase/api": "workspace:*",
    "@supabase/config": "workspace:*",
    "@supabase/pg-delta": "1.0.0-alpha.47",
    "@supabase/pg-topo": "1.0.0-alpha.6",
    "@supabase/stack": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@vercel/detect-agent": "^1.2.5",
    "@vitest/coverage-v8": "catalog:",
    "dotenv": "^17.4.2",
    "effect": "catalog:",
    "esbuild": "^0.28.2",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "posthog-node": "^5.51.2",
    "prettier": "3.9.6",
    "semantic-release": "catalog:",
    "smol-toml": "^1.8.0",
    "tldts": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "vitest": "catalog:",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "@supabase/cli-darwin-arm64": "workspace:*",
    "@supabase/cli-darwin-x64": "workspace:*",
    "@supabase/cli-linux-arm64": "workspace:*",
    "@supabase/cli-linux-arm64-musl": "workspace:*",
    "@supabase/cli-linux-x64": "workspace:*",
    "@supabase/cli-linux-x64-musl": "workspace:*",
    "@supabase/cli-windows-arm64": "workspace:*",
    "@supabase/cli-windows-x64": "workspace:*"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "develop",
        "prerelease": "beta",
        "channel": "beta"
      }
    ],
    "plugins": [
      "./scripts/analyze-commits-title.js",
      "@semantic-release/release-notes-generator"
    ]
  }
}
