# Copy to .env.local and fill in values from your throwaway Supabase project.
# Dashboard → Settings → API

SUPABASE_PROJECT_REF=your-twenty-char-project-ref
SUPABASE_URL=https://your-twenty-char-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Built CLI from feat/functions-deploy branch (run: pnpm exec nx run supabase:build from cli/)
# Use supabase-legacy for Go-parity shell, or supabase-next for v3 shell.
SUPABASE_CLI=./apps/cli/dist/supabase-legacy
