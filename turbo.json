{
  "$schema": "https://turborepo.com/schema.json",
  "futureFlags": {
    "strictTaskEntrypointSelection": true
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "types:check": {
      "cache": true,
      "dependsOn": ["transit"]
    },
    "lint:check": {
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "lint:actions:check": {
      "cache": false
    },
    "fmt:check": {
      "cache": false
    },
    "fmt:fix": {
      "cache": false
    },
    "knip:check": {
      "cache": false
    },
    "knip:fix": {
      "cache": false
    },
    "test:unit:run": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "test:integration:run": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "test:e2e:run": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "supabase#build": {
      "cache": true,
      "dependsOn": ["supabase#schemas:generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/mise.lock",
        "$TURBO_ROOT$/packages/api/**",
        "$TURBO_ROOT$/packages/stack/package.json",
        "$TURBO_ROOT$/packages/stack/src/**"
      ],
      "outputs": ["dist/**"]
    },
    "@supabase/config#build": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/mise.lock"],
      "outputs": ["dist/**"]
    },
    "@supabase/api#generate": {
      "cache": false,
      "outputs": ["src/generated/**", "scripts/openapi-source.json"],
      "env": ["SUPABASE_API_URL"]
    },
    "@supabase/stack#generate": {
      "cache": false,
      "outputs": ["src/functions/generated/**"]
    },
    "supabase#schemas:generate": {
      "cache": true,
      "dependsOn": ["@supabase/config#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!schemas/**",
        "$TURBO_ROOT$/mise.lock",
        "$TURBO_ROOT$/packages/stack/package.json",
        "$TURBO_ROOT$/packages/stack/src/**"
      ],
      "outputs": ["schemas/**"]
    },
    "supabase#test:live": {
      "cache": false,
      "dependsOn": ["supabase#build"],
      "passThroughEnv": ["*"]
    },
    "@supabase/cli-e2e#record": {
      "cache": false,
      "dependsOn": ["supabase#build"],
      "passThroughEnv": ["*"]
    },
    "supabase#test:smoke": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "supabase#test:e2e:run": {
      "cache": false,
      "passThroughEnv": ["*"],
      "dependsOn": ["supabase#build"]
    },
    "@supabase/cli-e2e#test:e2e:run": {
      "cache": false,
      "passThroughEnv": ["*"],
      "dependsOn": ["supabase#build"]
    }
  }
}
