  {
    "op": "add",
    "path": "/paths/~1v2~1projects~1{ref}~1warehouse~1enable",
    "value": {
      "post": {
        "description": "Enables replication for the currently eligible tables in a schema, or the named tables in that schema. Resolves source identities under the mutation lock without a preview or revision. Repeating the same selection is safe; a different existing selection is rejected. Schema selection excludes future tables; selected partition roots include future partitions. Acceptance does not imply completed synchronization.\n\nThis endpoint is currently in its **Alpha** stage.",
        "operationId": "v2-enable-warehouse",
        "parameters": [
          {
            "name": "ref",
            "required": true,
            "in": "path",
            "description": "Project ref",
            "schema": {
              "minLength": 20,
              "maxLength": 20,
              "pattern": "^[a-z]+$",
              "example": "abcdefghijklmnopqrst",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V2WarehouseEnableRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2WarehouseEnableAcceptedResponse_Output"
                }
              }
            },
            "links": {
              "setup": {
                "operationId": "v2-get-warehouse-setup",
                "parameters": {
                  "ref": "$request.path.ref",
                  "selection_id": "$response.body#/data/attributes/selection_id"
                }
              }
            }
          },
          "400": {
            "description": "Empty or unsupported selection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "402": {
            "description": "This feature requires the Pro, Team, or Enterprise organization plan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden action",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "409": {
            "description": "Existing selection or lifecycle conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "503": {
            "description": "Warehouse setup unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Enable Warehouse replication",
        "tags": ["Projects Warehouse"],
        "x-allowed-plans": ["Pro", "Team", "Enterprise"],
        "x-badges": [
          {
            "name": "OAuth scope: database:write",
            "position": "after"
          },
          {
            "name": "Only available on Pro, Team, Enterprise",
