  {
    "op": "add",
    "path": "/paths/~1v2~1projects~1{ref}~1warehouse~1setups~1current",
    "value": {
      "get": {
        "description": "Returns setup phases, linked tables, pipeline and routing state, cleanup errors, and optional FDW inspection. Set inspect_fdw=false to skip database FDW inspection. A null table replication_state means no observation is available. Status succeeded requires initial copy, a running pipeline and ready routing; it does not verify query connectivity. Pass the selection_id returned by enable to reject a changed selection while waiting.\n\nThis endpoint is currently in its **Alpha** stage.",
        "operationId": "v2-get-warehouse-setup",
        "parameters": [
          {
            "name": "ref",
            "required": true,
            "in": "path",
            "description": "Project ref",
            "schema": {
              "minLength": 20,
              "maxLength": 20,
              "pattern": "^[a-z]+$",
              "example": "abcdefghijklmnopqrst",
              "type": "string"
            }
          },
          {
            "name": "inspect_fdw",
            "required": false,
            "in": "query",
            "description": "Inspect database FDW state. Defaults to true for current-status reads and false when selection_id is supplied.",
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            }
          },
          {
            "name": "selection_id",
            "required": false,
            "in": "query",
            "description": "Accepted selection identity returned by enable. A different current nonempty selection returns a conflict.",
            "schema": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2WarehouseSetupStatusResponse_Output"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden action",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "409": {
            "description": "The accepted selection changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          },
          "503": {
            "description": "Warehouse status unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get Warehouse initial synchronization status",
        "tags": ["Projects Warehouse"],
        "x-badges": [
          {
            "name": "OAuth scope: database:read",
            "position": "after"
          },
          {
            "name": "Alpha",
            "position": "before"
          }
        ],
        "x-operation": {
          "group": "warehouse",
          "method": "status",
          "poll": {
            "status": "/data/attributes/status",
            "succeeded": ["succeeded"],
            "failed": ["failed"],
            "error": "/data/attributes/status_error"
          }
        },
        "x-endpoint-owners": ["pipelines"],
        "x-fga-permissions": [["database_read"]],
        "x-oauth-scope": "database:read",
        "x-scalar-stability": "experimental"
      }
    },
    "$comment": "Staging-only operation; remove once the production Management API ships it."
  },
  {
    "op": "add",
    "path": "/components/schemas/V2WarehouseEnableRequest",
    "value": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "Resource type.",
              "enum": ["warehouse_setup"]
            },
            "attributes": {
              "type": "object",
              "properties": {
                "warehouse_region": {
                  "description": "Optional Warehouse compute region, independent of the source and catalog regions. Defaults to the existing assignment, or ap-southeast-1 in staging and eu-west-1 in production for a new assignment. DNS routing requires a registered cluster in that environment. Unsupported regions and changes to an existing assignment are rejected. Ignored when targets is empty.",
                  "example": "ap-southeast-1",
                  "type": "string",
                  "minLength": 1
                },
                "destination_project_ref": {
                  "description": "Supabase project to use for both the DuckLake PostgreSQL catalog and Supabase Storage. Defaults to this project on first setup and to the configured destination on later requests. The destination must be active and healthy, and another project requires SQL and Storage admin write permissions. An existing destination cannot be changed through setup. Ignored when targets is empty.",
                  "example": "zyxwvutsrqponmlkjihg",
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 20,
                  "pattern": "^[a-z]+$"
                },
                "install_fdw": {
                  "description": "Whether to configure and install the Warehouse FDW in the project database. Defaults to false. Ignored when targets is empty.",
                  "example": false,
                  "type": "boolean"
                },
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Source PostgreSQL schema. Without tables, selects its currently eligible tables only.",
                  "example": "public"
                },
                "tables": {
                  "description": "Table names in schema. Omit to select the currently eligible tables in that schema.",
                  "x-ignore-array-items-must-be-objects": true,
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": ["schema"],
              "additionalProperties": false
            }
          },
          "required": ["type", "attributes"]
        }
      },
      "required": ["data"]
    },
    "$comment": "Staging-only operation; remove once the production Management API ships it."
  },
  {
    "op": "add",
    "path": "/components/schemas/V2WarehouseEnableAcceptedResponse_Output",
    "value": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "Resource type.",
              "enum": ["warehouse_setup"]
            },
            "id": {
              "type": "string"
            },
            "attributes": {
              "type": "object",
              "properties": {
                "tables": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "schema": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Postgres schema name",
                        "example": "public"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Postgres table name",
                        "example": "orders"
                      },
                      "state": {
                        "type": "string",
                        "enum": ["syncing", "live", "error"],
                        "description": "Warehouse copy sync state derived from replication status",
                        "example": "live"
                      },
                      "lag_ms": {
                        "description": "Replication lag in milliseconds, when available",
                        "example": 12000,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "last_synced_at": {
                        "description": "Last sync timestamp, when available",
                        "example": "2026-06-23T17:48:00Z",
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      "copy_name": {
                        "type": "string",
                        "description": "DuckLake table path with individually quoted identifiers, including the configured project namespace when present",
                        "example": "\"abcjuqabhgwjjutfvtpa\".\"public\".\"orders\""
                      },
                      "warehouse_size_bytes": {
                        "description": "Warehouse table size in bytes, when available",
                        "example": 197912092672,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["schema", "name", "state", "copy_name"]
                  },
                  "description": "Tables with Warehouse copies"
                },
                "pipeline_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Warehouse replication pipeline ID, or null when Warehouse disable has been requested",
                  "example": "03dg2o5teb2eucxr9ggh3uie6",
                  "nullable": true
                },
                "accepted": {
                  "type": "boolean",
                  "enum": [true]
                },
                "selected_tables": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "exclusiveMinimum": true,
                        "maximum": 4294967295,
                        "minimum": 0
                      },
                      "schema": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["id", "schema", "name"]
                  }
                },
                "selection_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "Identity of the accepted selection. Pass to the current setup read to reject a changed selection while waiting."
                }
              },
              "required": ["tables", "pipeline_id", "accepted", "selected_tables", "selection_id"]
            }
          },
          "required": ["type", "id", "attributes"]
        }
      },
      "required": ["data"]
    },
    "$comment": "Staging-only operation; remove once the production Management API ships it."
  },
  {
    "op": "add",
    "path": "/components/schemas/V2WarehouseSetupStatusResponse_Output",
    "value": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
