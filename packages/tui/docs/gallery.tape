# Records docs/gallery.gif. Run `vhs docs/gallery.tape` from packages/tui.
Output docs/gallery.gif

Set Shell "bash"
Set FontSize 16
Set Width 960
Set Height 900
Set Padding 24
Set TypingSpeed 40ms
Set Theme { "name": "Supabase Dark", "background": "#1C1C1C", "foreground": "#EDEDED", "cursor": "#3ECF8E", "selection": "#2E2E2E", "black": "#1C1C1C", "red": "#E54D2E", "green": "#3ECF8E", "yellow": "#DB8E00", "blue": "#5B8DEF", "magenta": "#7A66FF", "cyan": "#4CC3D9", "white": "#EDEDED", "brightBlack": "#898989", "brightRed": "#F2765B", "brightGreen": "#6BE0AB", "brightYellow": "#F2B33D", "brightBlue": "#82A8F4", "brightMagenta": "#9D8EFF", "brightCyan": "#7AD6E6", "brightWhite": "#FFFFFF" }
Env COLORTERM "truecolor"

Hide
Type "clear"
Enter
Show

Type "bun examples/gallery.ts"
Sleep 300ms
Enter
Sleep 4.5s
Enter
Sleep 1s
Down
Sleep 600ms
Down
Sleep 600ms
Up
Sleep 600ms
Enter
Sleep 2.5s
