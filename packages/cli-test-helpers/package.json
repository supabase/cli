{
  "name": "@supabase/cli-test-helpers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "pnpm run test:unit",
    "test:unit": "pnpm exec turbo run @supabase/cli-test-helpers#test:unit:run --",
    "test:unit:run": "bun --bun vitest run --project unit --coverage.reportsDirectory=coverage/unit",
    "types:check": "tsc --noEmit",
    "check:all": "pnpm exec turbo run types:check lint:check fmt:check knip:check --filter=$npm_package_name --filter=@supabase/root",
    "fix:all": "pnpm exec turbo run lint:fix fmt:fix knip:fix --filter=$npm_package_name --filter=@supabase/root"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
