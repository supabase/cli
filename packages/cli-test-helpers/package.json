{
  "name": "@supabase/cli-test-helpers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "pnpm run test:unit",
    "test:unit": "pnpm exec turbo run @supabase/cli-test-helpers#test:unit:run --",
    "test:unit:run": "bun --bun vitest run --project unit --coverage.reportsDirectory=coverage/unit",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
