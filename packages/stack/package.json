{
  "name": "@supabase/stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect.ts",
    "./testing": "./src/testing.ts",
    "./internal/supervisor": "./src/internal/supervisor-process.ts"
  },
  "scripts": {
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm exec turbo run @supabase/stack#test:unit:run --",
    "test:unit:run": "bun --bun vitest run --project unit",
    "test:integration": "pnpm exec turbo run @supabase/stack#test:integration:run --",
    "test:integration:run": "bun --bun vitest run --project integration",
    "test:e2e": "pnpm run test:e2e:run",
    "test:e2e:run": "bun --bun vitest run --project e2e",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "effect": "catalog:",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/ws": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "^0.28.2",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
