# Default all repository changes to the CLI team. Either owner satisfies code-owner review;
# `supabase-oss` approves only bot-opened PRs, through bot-pr-auto-merge.yml.
* @supabase/cli @supabase-oss

# These run trusted checkout code with secrets or deploy with admin credentials, so bot PRs
# touching them still need a maintainer.
/.github/workflows/ai-review.yml @supabase/cli
/.github/workflows/github-scripts-ci.yml @supabase/cli
/.github/scripts/ai-review/** @supabase/cli
/.github/ai-review/** @supabase/cli
/.github/workflows/cli-artifacts-infra.yml @supabase/cli
