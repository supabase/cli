# Default all repository changes to the CLI team.
* @supabase/cli

# Files that bots update. Either owner satisfies code-owner review; `supabase-oss` approves only
# bot-opened PRs, through bot-pr-auto-merge.yml.
/.github/workflows/*.yml @supabase/cli @supabase-oss
/package.json @supabase/cli @supabase-oss
/apps/*/package.json @supabase/cli @supabase-oss
/packages/*/package.json @supabase/cli @supabase-oss
/tools/*/package.json @supabase/cli @supabase-oss
/pnpm-lock.yaml @supabase/cli @supabase-oss
/pnpm-workspace.yaml @supabase/cli @supabase-oss
/apps/cli-go/go.mod @supabase/cli @supabase-oss
/apps/cli-go/go.sum @supabase/cli @supabase-oss
/apps/cli-go/pkg/go.mod @supabase/cli @supabase-oss
/apps/cli-go/pkg/go.sum @supabase/cli @supabase-oss
/apps/cli/src/shared/services/Dockerfile @supabase/cli @supabase-oss
/apps/cli-go/pkg/config/templates/Dockerfile @supabase/cli @supabase-oss
/packages/stack/src/Artifacts.ts @supabase/cli @supabase-oss
/apps/cli-go/api/v1-openapi.yaml @supabase/cli @supabase-oss
/apps/cli-go/pkg/api/*.gen.go @supabase/cli @supabase-oss
/packages/api/src/generated/ @supabase/cli @supabase-oss
/packages/api/scripts/openapi-source.json @supabase/cli @supabase-oss

# These run trusted checkout code with secrets or deploy with admin credentials, so bot PRs
# touching them still need a maintainer. Last matching pattern wins.
/.github/workflows/ai-review.yml @supabase/cli
/.github/workflows/github-scripts-ci.yml @supabase/cli
/.github/workflows/cli-artifacts-infra.yml @supabase/cli
