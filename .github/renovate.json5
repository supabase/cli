{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "baseBranches": ["develop"],
  "branchPrefix": "renovate/",
  "configMigration": true,
  "dependencyDashboard": true,
  "enabledManagers": ["github-actions", "gomod", "npm", "dockerfile"],
  "includePaths": [
    ".github/actions/**",
    ".github/workflows/**",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "apps/**/package.json",
    "packages/**/package.json",
    "tools/**/package.json",
    "apps/cli-go/go.mod",
    "apps/cli-go/go.sum",
    "apps/cli-go/fsevents/go.mod",
    "apps/cli-go/pkg/go.mod",
    "apps/cli-go/pkg/go.sum",
    "apps/cli-go/pkg/config/templates/Dockerfile",
  ],
  "labels": ["dependencies", "renovate"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"],
    "semanticCommitScope": "deps",
    "semanticCommitType": "chore",
  },
  "packageRules": [
    {
      "description": "Allow low-risk patch and minor dependency updates to enter the auto-merge path after CI passes.",
      "addLabels": ["automerge"],
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "rollback"],
    },
    {
      "description": "Allow grouped major dependency updates to enter the auto-merge path after CI passes.",
      "addLabels": ["automerge"],
      "automerge": true,
      "matchUpdateTypes": ["major"],
    },
    {
      "description": "Match the previous Dependabot cooldown for non-Docker ecosystems.",
      "matchManagers": ["github-actions", "gomod", "npm"],
      "minimumReleaseAge": "7 days",
    },
    {
      "description": "Use CI-scoped conventional commits for GitHub Actions updates.",
      "matchManagers": ["github-actions"],
      "semanticCommitScope": "ci",
      "semanticCommitType": "chore",
    },
    {
      "description": "Group GitHub Actions major updates like the old Dependabot config.",
      "groupName": "actions-major",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
    },
    {
      "description": "Keep setup-cli major updates disabled.",
      "enabled": false,
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["supabase/setup-cli"],
      "matchUpdateTypes": ["major"],
    },
    {
      "description": "Use dependency-scoped conventional commits for npm updates.",
      "matchManagers": ["npm"],
      "postUpdateOptions": ["pnpmDedupe"],
      "semanticCommitScope": "deps",
      "semanticCommitType": "chore",
    },
    {
      "description": "Group npm updates like the old Dependabot config.",
      "groupName": "npm-major",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
    },
    {
      "description": "Use dependency-scoped conventional commits for Go updates.",
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"],
      "semanticCommitScope": "deps",
      "semanticCommitType": "chore",
    },
    {
      "description": "Keep the manually managed Go dependencies disabled.",
      "enabled": false,
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "github.com/compose-spec/compose-go/v2",
        "github.com/docker/cli",
        "github.com/docker/docker",
      ],
    },
    {
      "description": "Group Go minor and patch updates like the old Dependabot config.",
      "groupName": "go-minor",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
    },
    {
      "description": "Group Go major updates by ecosystem.",
      "groupName": "go-major",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
    },
    {
      "description": "Use the previous Docker conventional commit shape.",
      "matchManagers": ["dockerfile"],
      "semanticCommitScope": "docker",
      "semanticCommitType": "fix",
    },
    {
      "description": "Match the previous Dependabot cooldown for managed non-Supabase Docker images.",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["postgrest/postgrest"],
      "minimumReleaseAge": "7 days",
    },
    {
      "description": "Keep ignored template images disabled.",
      "enabled": false,
      "matchManagers": ["dockerfile"],
      "matchPackageNames": [
        "library/kong",
        "kong",
        "axllent/mailpit",
        "darthsim/imgproxy",
        "timberio/vector",
      ],
    },
    {
      "description": "Group Docker minor and patch updates like the old Dependabot config.",
      "groupName": "docker-minor",
      "matchFileNames": ["apps/cli-go/pkg/config/templates/Dockerfile"],
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch"],
    },
    {
      "description": "Group Docker major updates by ecosystem.",
      "groupName": "docker-major",
      "matchFileNames": ["apps/cli-go/pkg/config/templates/Dockerfile"],
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["major"],
    },
    {
      "description": "Sync the generated stack service manifest in the same Renovate commit as Dockerfile updates.",
      "matchFileNames": ["apps/cli-go/pkg/config/templates/Dockerfile"],
      "matchManagers": ["dockerfile"],
      "postUpgradeTasks": {
        "commands": ["bun packages/stack/scripts/sync-versions-from-dockerfile.ts"],
        "executionMode": "branch",
        "fileFilters": [
          "apps/cli-go/pkg/config/templates/Dockerfile",
          "packages/stack/src/versions.ts",
        ],
        "installTools": {
          "bun": {},
        },
      },
    },
  ],
}
